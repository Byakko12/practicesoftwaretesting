# Copia este archivo como .env (NO se sube al repositorio).
# Las URLs de cada ambiente están en environments/<ambiente>.env; aquí solo van
# el ambiente elegido, secretos y overrides personales.

# Ambiente: qa | with-bugs  (por defecto qa)
TEST_ENV=qa

# ── Secretos (opcionales: el test C1 se salta si no están) ──
# Usuario ya registrado en el ambiente. Nunca los escribas en el código.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# ── Overrides opcionales ──
# BASE_URL=
# API_URL=
# RETRIES=0
# WORKERS=2
